# itsecuritynow.com — send www to the main domain (one address for Google)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.itsecuritynow\.com$ [NC]
RewriteRule ^ https://itsecuritynow.com%{REQUEST_URI} [L,R=301]

# Old website's addresses that Google still shows -> closest current page
RewriteRule ^security-validation/?$ /security/ [L,R=301]
RewriteRule ^partners-&-vendors/?$ /about/ [L,R=301]
RewriteRule ^sitemap\.website\.xml$ /sitemap.xml [L,R=301]

# The VAR page became the About Us page
RewriteRule ^healthcare-var/?$ /about/ [L,R=301]

# The Consulting page was removed
RewriteRule ^consulting/?$ /about/ [L,R=301]

# ---------- Security ----------
# No access to project files that are not part of the website
RewriteRule (^|/)\.(?!well-known/) - [F]
RewriteRule (^|/)README\.md$ - [F,NC]

<IfModule mod_headers.c>
  # Always use HTTPS for the next year
  Header always set Strict-Transport-Security "max-age=31536000"
  # Browsers must not guess file types
  Header always set X-Content-Type-Options "nosniff"
  # The site may not be shown inside another site's frame (stops clickjacking)
  Header always set X-Frame-Options "DENY"
  # Send only the site address, not the full page address, to other sites
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # The site never needs the camera, microphone or location
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Only load scripts, styles and fonts from the places this site really uses, and only send data to the form service and Google Analytics.
  # Google Analytics reports to several Google addresses (analytics.google.com, www.google.com, doubleclick.net); all must stay listed or Analytics records nothing.
  # If a new outside service is added (a booking tool, a chat widget, a video), add its address here or it will be blocked.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formsubmit.co https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.doubleclick.net; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  # Do not advertise server software
  Header always unset X-Powered-By
</IfModule>
